{
  "name": "explainback",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:migrate:local": "wrangler d1 migrations apply explainback --local",
    "cf:migrate:remote": "wrangler d1 migrations apply explainback --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3",
    "wrangler": "^4.129.0"
  }
}
