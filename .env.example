# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Engine model.
# claude-haiku-4-5 — fastest, keeps a full loop inside a few seconds (default)
# claude-sonnet-5  — deeper read of the mechanism, roughly 2x slower
EXPLAINBACK_MODEL=claude-haiku-4-5

# Where the SQLite file lives. Defaults to ./.data
# EXPLAINBACK_DATA_DIR=.data
